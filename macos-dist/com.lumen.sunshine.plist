<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lumen.sunshine</string>
    <!-- Run at interactive scheduling priority (not throttled daemon tier), so the
         x264 encoder threads aren't preempted by audio/WindowServer under load.
         This matches how it was scheduled when launched from Terminal. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ProgramArguments</key>
    <array>
        <string>$HOME/Applications/Skylight.app/Contents/MacOS/sunshine</string>
    </array>
    <!-- Phase C (docs/design/2026-07-19-daemon-lifecycle-coupling.md §4/§7/§8): the daemon is
         purely ON-DEMAND -- no RunAtLoad, no KeepAlive. launchd holds the MachServices
         registration below and (re)launches the daemon only when the menu's XPC connection
         demands it; a job with MachServices and no KeepAlive stays registered and demand-
         launchable indefinitely regardless of prior exit status (man launchd.plist). The
         daemon self-terminates when no validated menu is attached (capture gate at boot,
         NOTE_EXIT + presence-window backstop at runtime), so: menu visible <=> daemon running.
         Rollback lever if demand-relaunch ever misbehaves: KeepAlive={Crashed:true} (relaunch
         only on abnormal exit -- a menu-death shutdown is a clean exit, so this still never
         resurrects a menu-less daemon). -->
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>WorkingDirectory</key>
    <string>$HOME/.local/share/lumen</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
    <key>StandardOutPath</key>
    <string>$HOME/.config/skylight/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/.config/skylight/launchd.err.log</string>
    <key>MachServices</key>
    <dict>
        <key>com.example.lumen.xpc</key>
        <true/>
    </dict>
</dict>
<!-- REFERENCE SNAPSHOT: this tracked copy is not read at install time -- make-bundle.sh
     generates and installs the live agent inline (see its "launchd agent" step) with real
     $HOME/label values substituted at build time. Paths above use literal "$HOME" as a
     placeholder for readability/grep; this file is not templated or rendered by any script. -->
</plist>
