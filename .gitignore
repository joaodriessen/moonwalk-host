# Build artifacts
build/
node_modules/
__pycache__/
*.dmg

# Regenerated into the source tree on every cmake configure (BUILD_DOCS=ON,
# third-party/doxyconfig copies these into docs/) — docs/Doxyfile itself is a real tracked
# stub, do not ignore that one. Note: doxyconfig.css has no hyphen, hence the bare prefix glob.
docs/doxyconfig*

# clangd index (regenerated locally, not source)
.cache/

# macOS
.DS_Store
*.dSYM/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary
*.log
*.tmp
.worktrees/

# Runtime/dev scratch files regenerated by the running host and by ad-hoc
# manual file-write smoke tests — never source, safe to delete anytime.
sunshine_state.json
write_file_test_*.txt
build-xpc/

# Generated identity (per-machine; see macos-dist/generate-identity.sh)
src/platform/macos/generated_identity.h
macos-dist/SkylightMenu/Sources/SkylightMenu/GeneratedIdentity.swift
macos-dist/skylight-identity.local.conf

# Local coding-agent state is not source or release material.
.claude/
.codex/
