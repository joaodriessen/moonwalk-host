+/*
+ * Follow live_bitrate on the running session. VideoToolbox applies both properties
+ * to frames submitted from here on, with no new session and no keyframe. A rate
+ * the session refuses is left for the next change rather than failing the frame.
+ */
+static void vtenc_apply_live_bitrate(AVCodecContext *avctx, VTEncContext *vtctx)
+{
+    SInt32 bit_rate;
+    int64_t bytes_per_second, one_second = 1;
+    CFNumberRef bit_rate_num, bytes_num, second_num;
+    OSStatus status;
+
+    if (!vtctx->live_bitrate || vtctx->live_bitrate == vtctx->applied_live_bitrate)
+        return;
+    vtctx->applied_live_bitrate = vtctx->live_bitrate;
+
+    bit_rate = (SInt32)FFMIN(vtctx->live_bitrate, INT32_MAX);
+    bit_rate_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &bit_rate);
+    if (!bit_rate_num)
+        return;
+    status = VTSessionSetProperty(vtctx->session,
+                                  vtctx->constant_bit_rate ? compat_keys.kVTCompressionPropertyKey_ConstantBitRate
+                                                           : kVTCompressionPropertyKey_AverageBitRate,
+                                  bit_rate_num);
+    CFRelease(bit_rate_num);
+    if (status)
+        av_log(avctx, AV_LOG_WARNING, "Error changing bitrate: %d\n", (int)status);
+
+    bytes_per_second = vtctx->live_bitrate >> 3;
+    bytes_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &bytes_per_second);
+    second_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &one_second);
+    if (bytes_num && second_num) {
+        const void *nums[2] = { bytes_num, second_num };
+        CFArrayRef limits = CFArrayCreate(kCFAllocatorDefault, nums, 2, &kCFTypeArrayCallBacks);
+        if (limits) {
+            status = VTSessionSetProperty(vtctx->session, kVTCompressionPropertyKey_DataRateLimits, limits);
+            if (status)
+                av_log(avctx, AV_LOG_DEBUG, "Error changing max bitrate: %d\n", (int)status);
+            CFRelease(limits);
+        }
+    }
+    if (bytes_num)
+        CFRelease(bytes_num);
+    if (second_num)
+        CFRelease(second_num);
+}
